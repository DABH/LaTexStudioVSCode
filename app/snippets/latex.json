{
  "Document skeleton (article)": {
    "prefix": "doc-article",
    "body": [
      "\\documentclass[${1:11pt}]{article}",
      "\\usepackage[a4paper,margin=1in]{geometry}",
      "\\usepackage{microtype}",
      "\\usepackage{amsmath, amssymb}",
      "\\usepackage{hyperref}",
      "",
      "\\title{${2:Title}}",
      "\\author{${3:Author}}",
      "\\date{\\today}",
      "",
      "\\begin{document}",
      "\\maketitle",
      "",
      "$0",
      "",
      "\\end{document}"
    ],
    "description": "Article document skeleton with sane defaults"
  },
  "Section": {
    "prefix": "sec",
    "body": ["\\section{${1:Title}}", "\\label{sec:${2:label}}", "$0"]
  },
  "Subsection": {
    "prefix": "ssec",
    "body": ["\\subsection{${1:Title}}", "\\label{sec:${2:label}}", "$0"]
  },
  "Figure": {
    "prefix": "fig",
    "body": [
      "\\begin{figure}[${1:htbp}]",
      "  \\centering",
      "  \\includegraphics[width=${2:0.8\\linewidth}]{${3:path}}",
      "  \\caption{${4:Caption}}",
      "  \\label{fig:${5:label}}",
      "\\end{figure}",
      "$0"
    ]
  },
  "Table": {
    "prefix": "tab",
    "body": [
      "\\begin{table}[${1:htbp}]",
      "  \\centering",
      "  \\begin{tabular}{${2:lcr}}",
      "    \\toprule",
      "    ${3:Header} \\\\\\\\",
      "    \\midrule",
      "    ${4:row} \\\\\\\\",
      "    \\bottomrule",
      "  \\end{tabular}",
      "  \\caption{${5:Caption}}",
      "  \\label{tab:${6:label}}",
      "\\end{table}",
      "$0"
    ]
  },
  "Equation": {
    "prefix": "eq",
    "body": [
      "\\begin{equation}",
      "  \\label{eq:${1:label}}",
      "  ${2}",
      "\\end{equation}",
      "$0"
    ]
  },
  "Align": {
    "prefix": "align",
    "body": [
      "\\begin{align}",
      "  ${1} &= ${2} \\\\\\\\",
      "  ${3} &= ${4}",
      "\\end{align}",
      "$0"
    ]
  },
  "Itemize": {
    "prefix": "itemize",
    "body": [
      "\\begin{itemize}",
      "  \\item ${1}",
      "  \\item ${2}",
      "\\end{itemize}",
      "$0"
    ]
  },
  "Enumerate": {
    "prefix": "enumerate",
    "body": [
      "\\begin{enumerate}",
      "  \\item ${1}",
      "  \\item ${2}",
      "\\end{enumerate}",
      "$0"
    ]
  },
  "Generic environment": {
    "prefix": "env",
    "body": ["\\begin{${1:env}}", "  $0", "\\end{${1:env}}"]
  },
  "TeX root magic comment": {
    "prefix": "texroot",
    "body": ["% !TEX root = ${1:main.tex}"]
  }
}
