{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/app",
        "${workspaceFolder}/app/sample"
      ],
      "outFiles": ["${workspaceFolder}/app/out/**/*.js"],
      "preLaunchTask": "npm: compile - app"
    }
  ]
}
